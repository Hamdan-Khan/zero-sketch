{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zerosketch-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "../../Dockerfile",
      "max_instances": 4,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API_CONTAINER",
        "class_name": "ApiContainer",
      },
    ],
  },
  "exports": {
    "ApiContainer": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
